{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "functions/**/*.js",
    "js/muse-sync.js",
    "js/muse-observe.js",
    "tools/*.mjs",
    "scripts/*.mjs"
  ],
  "exclude": ["node_modules", "js/vendor"]
}
